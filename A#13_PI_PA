// Definición de pines
const int sensorTemp = A0;
const int sensorPresion = A1;
const int sensorContador = 2;
const int ledAlarma = 13;

volatile int contador = 0;

void contarObjeto() {
contador++;
}
void setup() {
pinMode(ledAlarma, OUTPUT);
pinMode(sensorContador, INPUT_PULLUP);
attachInterrupt(digitalPinToInterrupt(sensorContador), contarObjeto, FALLING);
Serial.begin(9600);
}
void loop() {
int lecturaTemp = analogRead(sensorTemp);
int lecturaPresion = analogRead(sensorPresion);

float temperatura = (lecturaTemp * 5.0 / 1023.0) * 100;
float presion = (lecturaPresion * 5.0 / 1023.0) * 50;

Serial.print("Temperatura: ");
Serial.print(temperatura);
Serial.print(" °C | Presión: ");
Serial.print(presion); 
 
Serial.print(" PSI | Conteo: ");
Serial.println(contador);

if (temperatura > 60 || presion > 40) {
digitalWrite(ledAlarma, HIGH);
} else {
digitalWrite(ledAlarma, LOW);
}

delay(1000);
}
